# Counterfactual Policy Experiment
policy_experiment <- function(datasets, delta = 0.20) {
# Get the 100 datasets with sample size 1000
data_list <- datasets[["1000"]]
# Partition each dataset into quartiles and retain the bottom quartile
bottom_quartile <- lapply(data_list, function(data) {
cutoff <- quantile(data$x, 0.25)
subset(data, x <= cutoff)
})
# Randomly select 50 datasets for treatment
treated_indices <- sample(1:n_datasets, n_polsamples)
# Apply treatment (20% increase in income) to treated datasets
treated <- lapply(1:100, function(i) {
data <- bottom_quartile[[i]]
if (i %in% treated_indices) {
data$Treat <- 1
data$x_post <- data$x * (1 + delta)
} else {
data$Treat <- 0
data$x_post <- data$x
}
data
})
# Calculate treatment effects
effects <- list()
# Treatment effect within treated households
for (i in treated_indices) {
data <- treated[[i]]
d_post <- ifelse(beta[1] + beta[2] * data$x_post + (revd(nrow(data), location = 0, scale = 1) - revd(nrow(data), location = 0, scale = 1)) >= 0, 1, 0)
d_pre <- data$d
effects[[paste0("within_", i)]] <- mean(d_post) - mean(d_pre)
}
# Treatment effect between treated and control groups
treated_group <- do.call(rbind, treated[treated_indices])
control_group <- do.call(rbind, treated[-treated_indices])
d_treated <- treated_group$d
d_control <- control_group$d
effects$between_groups <- mean(d_treated) - mean(d_control)
effects
}
# Run the policy experiment
policy_results <- policy_experiment(all_datasets)
# Run the policy experiment
policy_results <- policy_experiment(all_datasets)

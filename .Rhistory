# batches <- c(500, 1000) # Sample sizes
n_datasets <- 4            # test for small values
batches <- c(25, 40) # test for small values
# Simulate datasets
all_datasets <- list()
for (N in batches) {
datasets <- lapply(1:n_datasets, function(seed) gen_dataset(N, beta, seed))
all_datasets[[as.character(N)]] <- lapply(datasets, as.data.frame)
}
# SMM Estimation
estimate_smm <- function(data_list, S) {
estimates <- sapply(data_list, function(data) {
optim(par = c(0.5, 0.4), fn = solve_smm, data = data, S = S, method = "BFGS")$par
})
t(estimates)
}
#estimate_smm(all_datasets[[as.character(N)]], S=10)
# Function to compute statistics for estimates
compute_statistics <- function(estimates, true_beta) {
mean_est <- colMeans(estimates)
var_est <- apply(estimates, 2, var)
mse_est <- colMeans((estimates - matrix(true_beta, nrow(estimates), ncol(estimates), byrow = TRUE))^2)
list(mean = mean_est, variance = var_est, mse = mse_est)
}
# General function to perform SMM estimation for a given S
run_smm <- function(S) {
smm_results <- list()
for (N in batches) {
smm_results[[as.character(N)]] <- estimate_smm(all_datasets[[as.character(N)]], S)
}
lapply(smm_results, compute_statistics, true_beta = beta)
}

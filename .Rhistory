# Draw alternative-specific shocks epsilon_0 and epsilon_1 from Type I Extreme Value distribution
epsilon_0 <- revd(N)
epsilon_1 <- revd(N)
# Calculate the utility differences
u_diff <- beta[1] + beta[2] * x + (epsilon_1 - epsilon_0)
# Decision rule
d <- ifelse(u_diff >= 0, 1, 0)
# Return the dataset as a data frame
return(data.frame(x = x, d = d))
}
######## -------
# Function to compute moment conditions
solve_smm <- function(beta, data, S, seed = NULL) {
if (!is.null(seed)) set.seed(seed)
# as per the 2nd bullet in the comments for question 2,
# observables x, d are maintained...
x <- data$x
d <- data$d
# ...but new, S unobservable eps with N obs are drawn
# each one of the S simulations is stored in a column...
epsilon_0_sim <- replicate(S, revd(nrow(data)))
epsilon_1_sim <- replicate(S, revd(nrow(data)))
u_diff_sim <- beta[1] + beta[2] * x + (epsilon_1_sim - epsilon_0_sim)
d_sim <- ifelse(u_diff_sim >= 0, 1, 0)
m1 <- mean(d) - mean(rowSums(d_sim)/S)
m2 <- cov(x,d) - sum(cov(x, d_sim))/S
m <- c(m1, m2)
return(t(m) %*% m)
}

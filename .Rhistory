unlist %>%
data.frame(Dataset = names(.), Effect = .)
mean(ifelse(policy_data$Effect > 0, 1, 0))
# Create a bar plot
ggplot(policy_data, aes(x = reorder(Dataset, Effect), y = Effect)) +
geom_bar(stat = "identity", fill = "steelblue", alpha = 0.8) +
coord_flip() +  # Flip the coordinates for better readability
labs(title = "Treatment Effects for Each Dataset",
x = "Dataset",
y = "Effect Size") +
theme_minimal() +
theme(axis.text.y = element_text(size = 8))
ggplot(policy_data, aes(y = Effect)) +
geom_boxplot(fill = "skyblue", alpha = 0.7) +
labs(title = "Boxplot of Treatment Effects",
y = "Effect Size",
x = "") +
theme_minimal()
